# ============================================================
# FlyUp CRM — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# ============================================================

# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SEU_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SEU_SERVICE_ROLE_KEY   # Nunca exponha no frontend!

# Antigravity / CRM Access
SUPABASE_MCP_TOKEN=SEU_MCP_TOKEN
CRM_LOGIN=SEU_EMAIL_CRM

# N8N (opcional — para o workflow de webhook)
N8N_WEBHOOK_URL=http://SEU-N8N/webhook/flyup-lead

# Evolution API (configurado nos envs do N8N, mas útil para referência)
# EVOLUTION_API_URL=http://SEU-EVOLUTION-API
# EVOLUTION_INSTANCE=flyup
# EVOLUTION_API_KEY=SUA_CHAVE

# Segurança do webhook direto (opcional)
# WEBHOOK_SECRET=uma-chave-secreta-aleatoria
